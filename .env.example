# AI Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Default AI provider (openai | gemini)
DEFAULT_AI_PROVIDER=openai

# Models configuration (optional overrides)
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash

# Conversation memory TTL in minutes
CONVERSATION_TTL_MINUTES=30

# Privacy & Security: do not log prompts/queries to stdout/logs
LOG_PROMPTS=false

# Server port
PORT=3000

# Alexa Skill Verification (optional in local development, recommended in production)
VERIFY_ALEXA_SIGNATURE=false
ALEXA_SKILL_ID=
